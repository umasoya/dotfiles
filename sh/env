# Bash/Zsh共通。繰り返し読み込んでもPATHを重複させない。
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export DOT_DIR="${DOT_DIR:-$HOME/dotfiles}"

_dotfiles_prepend_path() {
    local remaining="$PATH" cleaned="" entry
    while [ -n "$remaining" ]; do
        entry="${remaining%%:*}"
        if [ "$entry" != "$1" ]; then
            cleaned="${cleaned:+$cleaned:}$entry"
        fi
        case "$remaining" in
            *:*) remaining="${remaining#*:}" ;;
            *) break ;;
        esac
    done
    PATH="$1${cleaned:+:$cleaned}"
}
_dotfiles_prepend_path "$HOME/bin"
_dotfiles_prepend_path "$HOME/.local/bin"

if [ -z "${LANG:-}" ]; then
    case "$(uname -s)" in
        Darwin) LANG=en_US.UTF-8 ;;
        *) LANG=C.UTF-8 ;;
    esac
fi
export LANG
export LESSCHARSET=UTF-8

export COMPOSER_PATH="$XDG_CONFIG_HOME/composer/vendor"
export COMPOSER_BIN="$COMPOSER_PATH/bin"
export GOPATH="${GOPATH:-$HOME/go}"
export GOBIN="${GOBIN:-$GOPATH/bin}"
_dotfiles_prepend_path "$COMPOSER_BIN"
_dotfiles_prepend_path "$GOBIN"
# Dedicated profile keeps dotfiles upgrades separate from personal Nix packages.
_dotfiles_prepend_path "$XDG_STATE_HOME/nix/profiles/dotfiles/bin"
export PATH
unset -f _dotfiles_prepend_path

export FILTER="fzf:peco:fzy"
export FZF_DEFAULT_OPTS="--ansi --select-1 --exit-0 --reverse --extended --cycle"
# Disable Pure's background fetch to avoid SSH authentication prompts.
export PURE_GIT_PULL=0
export GH_REPO_CLONE_PATH="$HOME/repos/src/github.com"
export NVM_DIR="${NVM_DIR:-$XDG_CONFIG_HOME/nvm}"
