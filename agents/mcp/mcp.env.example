# Copy to ${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/mcp.env and chmod 600.
# This file is sourced by run.sh; use shell quoting for special characters.

# Docker defaults to the endpoint of the currently selected Docker CLI context.
# DOCKER_HOST='unix:///path/to/docker.sock'

# WSL: connect to a separately started, debuggable Windows Chrome instance.
# CHROME_MCP_BROWSER_URL='http://127.0.0.1:9222'
# Or select a local Chrome executable (macOS / Linux).
# CHROME_MCP_EXECUTABLE='/path/to/chrome'

# GitHub MCP credentials are injected by 1Password via op run.
# Keep its secret reference in the separate, machine-local github.env file.
